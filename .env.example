# OpenAI or an OpenAI-compatible provider
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-sol

# Leave empty for the official OpenAI endpoint.
# Example local provider: http://localhost:11434/v1
OPENAI_BASE_URL=

# Runtime safeguards
REQUEST_TIMEOUT_SECONDS=20
MAX_AGENT_ROUNDS=4
MAX_CITIES=10
TRACE_DIR=traces
