# OpenAI or an OpenAI-compatible provider
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Leave empty for the official OpenAI endpoint.
# Example local provider: http://localhost:11434/v1
OPENAI_BASE_URL=

# Runtime safeguards
REQUEST_TIMEOUT_SECONDS=20
MAX_AGENT_ROUNDS=4
MAX_CITIES=10
TRACE_DIR=traces

# Override only for tests or compatible Open-Meteo deployments.
OPEN_METEO_GEOCODING_LANGUAGE=en
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
